{
  "name": "code-slices",
  "version": "0.1.0",
  "private": true,
  "description": "Build standalone code-review reports around selected execution slices.",
  "scripts": {
    "example": "node src/build.cjs examples/minimal/manifest.json dist/example.html",
    "example:pr": "node src/build-pr.cjs examples/pr-change/manifest.json dist/pr-change.html",
    "test:pr": "node --test test/pr-mode.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "typescript": "5.9.3"
  }
}
